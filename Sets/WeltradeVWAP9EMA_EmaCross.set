; WeltradeVWAP_9EMA_Signals - preset: EMA(9) crosses VWAP
; Load from the indicator's Inputs tab -> Load.
;
; Signal: buy when the 9 EMA crosses above VWAP, sell when it crosses below.
; Values shown are the enum indexes used by the indicator:
;   InpAnchor     0=Daily@custom hour  1=Daily@00:00  2=Weekly(Mon)  3=Rolling
;   InpEntryMode  0=EMA cross VWAP     1=Price+EMA+VWAP stack       2=VWAP pullback
;   InpEmaPrice   0=Close              1=Typical (O+H+L+C)/4
;   InpAmbiguousFirst 0=stop first     1=target first  (one bar touches both)

InpAnchor=0
InpSessionHour=0
InpSessionMinute=0
InpRollingBars=240
InpUseRealVolume=false

InpEntryMode=0
InpEmaPeriod=9
InpEmaPrice=0
InpTouchTolerancePoints=10
InpRequireReclaim=true

InpAtrPeriod=14
InpSlAtrMult=1.5
InpRewardR=3.0
InpBoxWidthBars=24
InpShowRMultiples=true
InpZonesBehindPrice=true

InpColorProfit=5737262
InpColorLoss=2237106
InpColorUp=16748574
InpColorDown=17919
InpUseTransparency=false
InpFillAlpha=55

InpAlertPopup=true
InpAlertSound=false
InpSoundFile=alert.wav
InpAlertPush=false
InpAlertEmail=false

InpMarkOutcome=true
InpTruncateOnHit=true
InpAmbiguousFirst=0
InpShowStats=true

InpMaxSignals=40
InpHistoryBars=500
InpShowPanel=true
InpDeleteOnRemove=true
