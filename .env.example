# Copy this file to ".env" and fill in your Weltrade MT5 demo/login details.
# NEVER commit your real .env to git.

# ── Weltrade MT5 login (find the exact server name in MT5: File → Login to Trade Account) ──
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=WeltradeInternational-Server
# Optional: full path to terminal64.exe if you run several MT5 terminals.
# MT5_PATH=C:\Program Files\Weltrade MT5\terminal64.exe

# ── Optional Telegram alerts ──
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_CHAT_ID=123456789
